page { min-height: 100%; background: #f6f8f7; color: #19342e; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.page { padding: 30rpx 30rpx 64rpx; }
.banner { padding: 24rpx 8rpx 30rpx; display: flex; flex-direction: column; gap: 10rpx; }
.eyebrow { color: #25735f; font-size: 23rpx; font-weight: 700; }
.title { font-size: 42rpx; font-weight: 700; }
.note, .footnote { color: #62736e; font-size: 24rpx; line-height: 1.65; }
.card { margin-bottom: 18rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(24, 62, 50, .06); }
.filter-card { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx 22rpx; }
.filter-label { color: #71817b; font-size: 24rpx; }
.picker { min-width: 220rpx; padding: 10rpx 18rpx; border-radius: 10rpx; color: #276b59; background: #edf5f1; font-size: 25rpx; }
.chevron { margin-left: 16rpx; }
.as-of { width: 100%; color: #71817b; font-size: 22rpx; }
.plan-card { padding: 28rpx; }
.plan-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.plan-date { font-size: 29rpx; font-weight: 700; }
.status { flex: none; padding: 6rpx 12rpx; border-radius: 8rpx; color: #276b59; background: #edf5f1; font-size: 22rpx; }
.recommendation { display: block; margin-top: 18rpx; color: #344d45; font-size: 26rpx; line-height: 1.65; overflow-wrap: anywhere; white-space: pre-wrap; }
.plan-meta { display: flex; justify-content: space-between; gap: 14rpx; margin-top: 20rpx; color: #71817b; font-size: 21rpx; }
.plan-id { overflow-wrap: anywhere; }
.overdue-yes { color: #a04a27; font-weight: 650; }
.open-link { display: block; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #edf1ef; color: #276b59; text-align: right; font-size: 23rpx; }
.state { color: #71817b; font-size: 25rpx; line-height: 1.6; }
.empty { text-align: center; }
.error { margin: 18rpx 0; padding: 20rpx; border-radius: 12rpx; color: #9a382c; background: #fff0ed; font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }
button { font-size: 26rpx; border-radius: 12rpx; }
.secondary { color: #276b59; background: #edf5f1; }
.more-button { margin: 12rpx 0; }
.back-button { margin: 18rpx 0; color: #276b59; background: #fff; }
.footnote { display: block; margin: 24rpx 8rpx 0; font-size: 21rpx; }

/* Shared patient-service visual system */
page { background: #f3f7f5; }
.page { padding: 30rpx 30rpx 72rpx; }
.banner { padding: 26rpx 8rpx 34rpx; }
.eyebrow { color: #176b55; font-size: 25rpx; letter-spacing: 1rpx; }
.title { color: #173f35; font-size: 42rpx; line-height: 1.3; }
.note, .footnote { font-size: 25rpx; line-height: 1.7; }
.card { border: 1rpx solid #e8efeb; border-radius: 24rpx; box-shadow: 0 10rpx 30rpx rgba(24,62,50,.055); }
.filter-card { min-height: 96rpx; }
.filter-label { font-size: 26rpx; }
.picker { min-height: 76rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 14rpx; font-size: 27rpx; }
.as-of { font-size: 24rpx; }
.plan-card { padding: 30rpx; }
.plan-heading { flex-wrap: wrap; align-items: center; }
.plan-date { font-size: 30rpx; line-height: 1.5; }
.status { padding: 8rpx 14rpx; border-radius: 12rpx; font-size: 25rpx; }
.recommendation { font-size: 28rpx; line-height: 1.75; }
.plan-meta { flex-wrap: wrap; margin-top: 22rpx; font-size: 24rpx; line-height: 1.55; }
.overdue-yes { color: #963d20; }
.open-link { font-size: 26rpx; }
.state { padding: 26rpx; border-radius: 14rpx; background: #f5f8f6; font-size: 27rpx; line-height: 1.65; }
.error { border: 1rpx solid #f0c9c1; border-radius: 16rpx; font-size: 26rpx; }
button { min-height: 88rpx; border-radius: 16rpx; font-size: 28rpx; font-weight: 650; }
.secondary { color: #205e4c; background: #edf5f1; }
.back-button { border: 1rpx solid #e1ebe6; }
.footnote { font-size: 24rpx; }