page { min-height:100%; background:#f3f7f5; color:#19342e; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
.page { padding:30rpx 30rpx 72rpx; }
.banner { display:flex; flex-direction:column; gap:10rpx; padding:28rpx 8rpx 32rpx; }
.eyebrow { color:#176b55; font-size:25rpx; font-weight:700; }
.title { color:#173f35; font-size:42rpx; font-weight:700; }
.note,.footnote { color:#62736e; font-size:25rpx; line-height:1.7; overflow-wrap:anywhere; }
.card { padding:28rpx; border:1rpx solid #e8efeb; border-radius:24rpx; background:#fff; box-shadow:0 10rpx 30rpx rgba(24,62,50,.055); }
.section { margin-top:22rpx; }
.section-title { display:block; margin-bottom:16rpx; color:#263f43; font-size:31rpx; font-weight:700; }
.picker { display:flex; min-height:90rpx; align-items:center; justify-content:space-between; gap:18rpx; border-top:1rpx solid #edf1ef; font-size:28rpx; }
.picker text:first-child { flex:none; color:#596d65; }
.picker text:last-child { color:#263f43; text-align:right; overflow-wrap:anywhere; }
.candidate { display:flex; flex-direction:column; gap:6rpx; min-height:86rpx; justify-content:center; margin-top:12rpx; padding:18rpx 20rpx; border:1rpx solid #d7e2dc; border-radius:16rpx; }
.candidate-selected { border:2rpx solid #176b55; background:#e9f4ef; }
.candidate-time { font-size:28rpx; font-weight:650; }
.candidate-dentist { color:#62736e; font-size:24rpx; }
.field { box-sizing:border-box; width:100%; min-height:90rpx; margin-top:14rpx; padding:18rpx 20rpx; border:1rpx solid #cbd9d2; border-radius:16rpx; background:#fbfdfc; font-size:28rpx; line-height:1.6; }
.multiline { min-height:170rpx; }
.summary-card { margin-top:22rpx; background:#f9fcfa; }
.summary-line { display:block; margin-bottom:8rpx; color:#263f43; font-size:27rpx; line-height:1.6; }
.restriction,.pending-card,.error { margin-bottom:18rpx; padding:22rpx; border:1rpx solid #ead8a8; border-radius:16rpx; background:#fff6df; color:#815317; font-size:26rpx; line-height:1.7; overflow-wrap:anywhere; }
.pending-title { display:block; margin-bottom:8rpx; color:#725111; font-size:29rpx; font-weight:700; }
.error { border-color:#f0c9c1; background:#fff0ed; color:#9a382c; }
.state { color:#71817b; font-size:27rpx; line-height:1.65; }
button { min-height:88rpx; border-radius:16rpx; font-size:28rpx; font-weight:650; }
.primary { margin-top:18rpx; color:#fff; background:#176b55; }
.submit { margin:24rpx 0; }
.retry-button { color:#205e4c; background:#edf5f1; }
.footnote { display:block; margin:25rpx 5rpx; padding-bottom:10rpx; font-size:24rpx; }

.selected-booking{border:2rpx solid #a8dcd5;background:#f6fcfa}.change-selection{margin:12rpx 0 0;background:#e5f3ef;color:#178475;min-height:64rpx;font-size:24rpx;padding:10rpx 18rpx}

/* ===== 科技蓝主题覆盖（2026-11-11） ===== */
page { background: #f4f8fe; color: #0b1b33; }
.page { padding: 24rpx 28rpx 220rpx; }
.card { background: #fff; border-radius: 28rpx; padding: 26rpx; box-shadow: 0 8rpx 24rpx rgba(20,50,110,.06); border: 0; }
.title { font-size: 28rpx; font-weight: 800; color: #0b1b33; }
.section-title { font-size: 27rpx; font-weight: 800; color: #0b1b33; }
.note, .footnote { color: #8c99ac; }
.selected-booking { background: #eef4ff; border: 2rpx solid #dbe7ff; border-radius: 24rpx; }
.summary-line { color: #31425c; }
.change-selection { color: #2f6bff; font-weight: 700; background: transparent; border: 0; }
.candidate { background: #fff; border: 2rpx solid #eef2fa; border-radius: 20rpx; }
.candidate-selected { border-color: #2f6bff; background: #f5f9ff; }
.candidate-dentist { color: #0b1b33; }
.candidate-time { color: #8c99ac; }
.field { background: #fff; border-radius: 22rpx; }
.picker { border-radius: 18rpx; }
.primary, .submit { background: linear-gradient(90deg, #2f6bff, #18b6ff) !important; color: #fff !important; border-radius: 20rpx; font-weight: 750; }
.summary-card { background: #eef4ff; border-radius: 24rpx; }
.pending-card { border-radius: 24rpx; background: #fff8e7; border: 2rpx solid #dfbf73; }
.error { background: #fdeeea; color: #b7452f; border-radius: 20rpx; }
.state { color: #aab6c6; }

/* 过期状态的重新读取按钮 */
.error .retry-button, .retry-button { background: #fff !important; color: #b7452f !important; border: 2rpx solid #f3c7bd; border-radius: 16rpx; }
