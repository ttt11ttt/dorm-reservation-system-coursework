page { min-height: 100%; background: #f6f8f7; color: #19342e; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.page { padding: 30rpx; }
.card { padding: 30rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(24, 62, 50, .06); }
.section { margin-top: 22rpx; }
.section-title { display: block; margin-bottom: 18rpx; font-size: 31rpx; font-weight: 700; }
.row { display: flex; justify-content: space-between; gap: 20rpx; padding: 18rpx 0; border-bottom: 1rpx solid #edf1ef; }
.label { flex: none; color: #71817b; font-size: 25rpx; }
.value { text-align: right; font-size: 26rpx; overflow-wrap: anywhere; line-height: 1.5; }
.note-block { display: flex; flex-direction: column; gap: 10rpx; padding-top: 18rpx; }
.note, .line-detail, .line-subtotal, .invoice-meta, .footnote { color: #62736e; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.state { color: #71817b; font-size: 25rpx; line-height: 1.6; }
.line { padding: 18rpx 0; border-bottom: 1rpx solid #edf1ef; }
.line-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.line-title { font-size: 27rpx; font-weight: 600; overflow-wrap: anywhere; }
.line-detail, .line-subtotal { display: block; margin-top: 8rpx; }
.line-subtotal { color: #2b5147; }
.zero-tag { flex: none; padding: 4rpx 10rpx; color: #276b59; background: #edf5f1; border-radius: 8rpx; font-size: 21rpx; }
.total-row { display: flex; justify-content: space-between; padding-top: 24rpx; font-size: 27rpx; font-weight: 650; }
.total { font-variant-numeric: tabular-nums; }
.footnote { display: block; margin-top: 22rpx; font-size: 22rpx; }
.error { padding: 22rpx; border-radius: 12rpx; color: #9a382c; background: #fff0ed; font-size: 25rpx; line-height: 1.5; overflow-wrap: anywhere; }
.actions { margin-top: 22rpx; padding: 24rpx; border-radius: 18rpx; background: #fff; }
.action-note { margin-top: 22rpx; padding: 22rpx; border-radius: 14rpx; background: #fff8e7; }
.pending-card { margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid #dfbf73; border-radius: 16rpx; background: #fff8e7; }
.pending-title { display: block; margin-bottom: 8rpx; color: #725111; font-size: 27rpx; font-weight: 700; }
.restriction { margin-top: 22rpx; padding: 22rpx; border-radius: 14rpx; color: #815317; background: #fff6df; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.phone-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 8rpx 0; }
.phone-button { margin: 0; padding: 0 12rpx; color: #276b59; background: #edf5f1; font-size: 22rpx; }

/* Shared patient-service visual system */
page { background: #f3f7f5; }
.page { padding: 30rpx 30rpx 72rpx; }
.card { border: 1rpx solid #e8efeb; border-radius: 24rpx; box-shadow: 0 10rpx 30rpx rgba(24,62,50,.055); }
.section { margin-top: 24rpx; }
.section-title { font-size: 32rpx; line-height: 1.35; }
.row { align-items: flex-start; padding: 21rpx 0; }
.label { color: #596d65; font-size: 26rpx; }
.value { color: #183a32; font-size: 28rpx; line-height: 1.6; }
.note, .line-detail, .line-subtotal, .invoice-meta { font-size: 25rpx; line-height: 1.7; }
.line { padding: 22rpx 0; }
.line-title { font-size: 29rpx; line-height: 1.5; }
.zero-tag { font-size: 24rpx; padding: 6rpx 12rpx; border-radius: 10rpx; }
.total-row { font-size: 29rpx; }
.total { color: #176b55; font-size: 32rpx; }
.state { padding: 24rpx; border-radius: 14rpx; background: #f5f8f6; font-size: 27rpx; }
.error, .restriction, .action-note { border-radius: 16rpx; font-size: 26rpx; line-height: 1.7; }
.actions { border: 1rpx solid #e8efeb; border-radius: 20rpx; }
.pending-card { border-radius: 18rpx; }
.pending-title { font-size: 29rpx; }
button { min-height: 88rpx; font-size: 28rpx; }
.phone-button { min-height: 72rpx; font-size: 24rpx; }
.footnote { font-size: 24rpx; }